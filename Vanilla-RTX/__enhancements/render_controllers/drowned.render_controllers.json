{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.drowned.rtx": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "part_visibility": [
        { "rtx_trident_pole": false }
      ],
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "query.is_baby ? Texture.baby : Texture.default" ]
    },
    "controller.render.drowned.rtx_baby_trident": {
      "geometry": "Geometry.baby",
      "part_visibility": [
        { "*": false },
        { "rtx_trident_pole": true }
      ],
      "materials": [ { "*": "Material.trident" } ],
      "textures": [ "Texture.trident" ]
    }
  }
}
